<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>SCENIX Forgot Password Email</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f5f7;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #17191c;
        -webkit-font-smoothing: antialiased;
      }
      .wrapper {
        padding: 40px 20px;
        width: 100%;
        box-sizing: border-box;
      }
      .container {
        max-width: 500px;
        margin: 0 auto;
      }
      .brand {
        font-size: 28px;
        font-weight: 800;
        color: #17191c;
        margin-bottom: 24px;
        padding-left: 4px;
      }
      .card {
        background-color: #ffffff;
        border: 1px solid #ebecf0;
        border-radius: 12px;
        padding: 40px;
      }
      .greeting {
        font-size: 16px;
        margin-bottom: 20px;
        font-weight: 500;
      }
      .instruction {
        font-size: 16px;
        margin-bottom: 32px;
      }
      .code-box {
        background-color: #f4f5f7;
        border-radius: 8px;
        padding: 24px;
        text-align: center;
        margin-bottom: 32px;
      }
      .code {
        font-family:
          "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 36px;
        font-weight: 700;

        letter-spacing: 8px; 
        white-space: nowrap;

        color: #17191c;
        padding-left: 0; /* remove extra shift */
      }
      .footer {
        font-size: 14px;
        color: #5e6c84;
        line-height: 1.6;
      }

      @media (prefers-color-scheme: dark) {
        body,
        .wrapper {
          background-color: #111214 !important;
          color: #eceff4 !important;
        }
        .brand {
          color: #ffffff !important;
        }
        .card {
          background-color: #1c1d21 !important;
          border-color: #2e3035 !important;
        }
        .code-box {
          background-color: #282a2e !important;
        }
        .code {
          color: #ffffff !important;
        }
        .footer {
          color: #a0aabf !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="brand">SCENIX</div>

        <div class="card">
          <div class="greeting">Hi there,</div>
          <div class="instruction">Enter this code to reset your SCENIX
            password:</div>

          <div class="code-box">
            <div class="code">{{otp}}</div>
          </div>

          <div class="footer">
            This code expires in 60 second. If you didn't request this, you can
            safely ignore this email.
          </div>
        </div>
      </div>
    </div>
  </body>
</html>